#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl jq openjdk-21-jre-headless

id -u minecraft >/dev/null 2>&1 || useradd --system --home /opt/minecraft --create-home --shell /usr/sbin/nologin minecraft

install -d -o minecraft -g minecraft /opt/minecraft
cd /opt/minecraft

VERSION="${minecraft_version}"
LATEST_BUILD="$(curl -fsSL "https://api.papermc.io/v2/projects/paper/versions/${minecraft_version}" | jq -r '.builds[-1]')"
PAPER_URL="https://api.papermc.io/v2/projects/paper/versions/${minecraft_version}/builds/${LATEST_BUILD}/downloads/paper-${minecraft_version}-${LATEST_BUILD}.jar"

curl -fsSL "$PAPER_URL" -o /opt/minecraft/paper.jar
chown minecraft:minecraft /opt/minecraft/paper.jar

cat > /opt/minecraft/eula.txt <<'EULA'
eula=true
EULA
chown minecraft:minecraft /opt/minecraft/eula.txt

cat > /etc/systemd/system/minecraft.service <<'SERVICE'
[Unit]
Description=Minecraft Server (PaperMC)
After=network-online.target
Wants=network-online.target

[Service]
User=minecraft
Group=minecraft
WorkingDirectory=/opt/minecraft
ExecStart=/usr/bin/java -Xms${xms_mb}M -Xmx${xmx_mb}M \
  -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 \
  -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch \
  -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M \
  -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 \
  -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 \
  -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 \
  -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1 \
  -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true \
  -jar /opt/minecraft/paper.jar nogui
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
SERVICE

chown root:root /etc/systemd/system/minecraft.service
chmod 0644 /etc/systemd/system/minecraft.service

systemctl daemon-reload
systemctl enable minecraft
systemctl restart minecraft
